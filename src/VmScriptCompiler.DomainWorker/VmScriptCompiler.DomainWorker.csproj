<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>vm-script-domain-worker</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VmScriptCompiler.Core\VmScriptCompiler.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\resources\**\*" Link="resources\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\schemas\**\*" Link="schemas\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\vm-solution-parser\**\*" Link="tools\vm-solution-parser\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\14-发布包使用说明.md" Link="USAGE.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
