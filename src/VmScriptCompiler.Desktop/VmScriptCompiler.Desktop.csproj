<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>vm-script-compiler-desktop</AssemblyName>
    <ApplicationIcon>..\..\assets\branding\vm-script-compiler.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VmScriptCompiler.Core\VmScriptCompiler.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\branding\vm-script-compiler.ico" Link="vm-script-compiler.ico" />
    <Resource Include="..\..\assets\branding\vm-script-compiler-icon-512.png" Link="vm-script-compiler-icon.png" />
    <Content Include="..\..\resources\**\*" Link="resources\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\schemas\**\*" Link="schemas\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\vm-solution-parser\**\*" Link="tools\vm-solution-parser\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\14-发布包使用说明.md" Link="USAGE.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
