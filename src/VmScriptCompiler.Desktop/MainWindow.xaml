<Window x:Class="VmScriptCompiler.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VM Script Solution Agent" Width="1420" Height="900" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#FF0D0D0D" Foreground="#FFF4F4F4"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#FF0D0D0D" />
        <SolidColorBrush x:Key="SidebarBackground" Color="#FF111111" />
        <SolidColorBrush x:Key="Surface" Color="#FF171717" />
        <SolidColorBrush x:Key="SurfaceRaised" Color="#FF1D1D1D" />
        <SolidColorBrush x:Key="SurfaceHover" Color="#FF242424" />
        <SolidColorBrush x:Key="Border" Color="#FF2B2B2B" />
        <SolidColorBrush x:Key="BorderStrong" Color="#FF414141" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FFF2F2F2" />
        <SolidColorBrush x:Key="TextSecondary" Color="#FFA5A5A5" />
        <SolidColorBrush x:Key="TextMuted" Color="#FF747474" />
        <SolidColorBrush x:Key="Accent" Color="#FF2F7DF4" />
        <SolidColorBrush x:Key="Success" Color="#FF50B67A" />
        <SolidColorBrush x:Key="Danger" Color="#FFE36B6B" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceHover}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value=".78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value=".42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Margin" Value="0,1" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#FFF2F2F2" />
            <Setter Property="Foreground" Value="#FF111111" />
            <Setter Property="BorderBrush" Value="#FFF2F2F2" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SendButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFD8D8D8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value=".38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SelectionBrush" Value="#FF315F91" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="ComboToggleButton" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ComboChrome" Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Margin="10,0,4,0" VerticalAlignment="Center"
                                                  TextElement.Foreground="{StaticResource TextPrimary}"
                                                  Content="{Binding SelectedItem.Content, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMuted}" Text="⌄" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="#FF5A5A5A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Style="{StaticResource ComboToggleButton}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,4,0,0" Padding="4" Background="{StaticResource SurfaceRaised}"
                                        BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="7">
                                    <ScrollViewer MaxHeight="260">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style x:Key="SettingsInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarPanel" Grid.Column="0" Background="{StaticResource SidebarBackground}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="4,4,2,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" Margin="0,0,9,0" Background="#FFF1F1F1" CornerRadius="8">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#FF111111" FontSize="11" FontWeight="Bold" Text="VM" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="VM Script Agent" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse x:Name="AgentStatusDot" Width="6" Height="6" Margin="0,0,5,0"
                                         VerticalAlignment="Center" Fill="#FFCE9B45" />
                                <TextBlock x:Name="AgentStatusText" FontSize="10.5"
                                           Foreground="{StaticResource TextMuted}" Text="正在启动" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="‹"
                            ToolTip="收起侧栏" Click="ToggleSidebar_Click" />
                </Grid>

                <Button Grid.Row="1" Style="{StaticResource PrimaryButton}" Height="38"
                        HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,9"
                        Content="＋  新任务" Click="NewConversation_Click" />

                <StackPanel Grid.Row="2">
                    <Button x:Name="ChatNavButton" Style="{StaticResource NavButton}"
                            Content="⌂   当前任务" Click="ShowComposer_Click" />
                    <Button x:Name="ArtifactsNavButton" Style="{StaticResource NavButton}"
                            Content="▣   结果产物" Click="ShowArtifacts_Click" />
                    <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}"
                            Content="⚙   设置" Click="ShowSettings_Click" />
                </StackPanel>

                <Grid Grid.Row="3" Margin="10,19,2,7">
                    <TextBlock Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Text="最近任务" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" Margin="0,0,3,0"
                                FontSize="12" Foreground="{StaticResource Danger}" Content="清"
                                ToolTip="清理全部历史对话" Click="ClearHistory_Click" />
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                                FontSize="13" Content="↻" ToolTip="刷新" Click="RefreshHistory_Click" />
                    </StackPanel>
                </Grid>

                <ListBox x:Name="RecentConversationList" Grid.Row="4"
                         SelectionChanged="RecentConversation_SelectionChanged"
                         MouseDoubleClick="RecentConversation_DoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="ToolTip" Value="{Binding Path}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemChrome" Padding="{TemplateBinding Padding}"
                                                Background="Transparent" CornerRadius="7">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource SurfaceHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemChrome" Property="Background" Value="#FF292929" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" FontSize="12.5" />
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="10.5"
                                           Foreground="{StaticResource TextMuted}" Text="{Binding DisplayTime}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="5" Margin="0,9,0,0">
                    <Border Margin="0,0,0,7" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" />
                    <Button Style="{StaticResource NavButton}" Content="↗   打开当前结果" Click="OpenConversationFolder_Click" />
                    <TextBlock x:Name="SidebarStatusText" Margin="11,4,8,5" FontSize="10.5"
                               Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource AppBackground}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ExpandSidebarButton" Visibility="Collapsed" Style="{StaticResource IconButton}"
                            Content="☰" ToolTip="展开侧栏" Click="ToggleSidebar_Click" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="WorkspaceTitleText" FontSize="13" FontWeight="SemiBold" Text="新任务" />
                        <Border Margin="9,0,0,0" Padding="7,2" Background="#FF1B1B1B"
                                BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10">
                            <TextBlock x:Name="WorkspacePhaseText" FontSize="10.5"
                                       Foreground="{StaticResource TextSecondary}" Text="draft" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="EnvironmentText" MaxWidth="310" Margin="0,0,12,0"
                                   VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMuted}"
                                   TextTrimming="CharacterEllipsis" Text="正在检测 VisionMaster…" />
                        <Button Style="{StaticResource IconButton}" Content="↻" ToolTip="重新连接 Agent"
                                Click="ReconnectAgent_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Background="{StaticResource AppBackground}" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed" /></Style>
                </TabControl.Resources>

                <TabItem x:Name="ComposerTab">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="TranscriptPanel" Width="840" MaxWidth="840"
                                        Margin="28,42,28,26" HorizontalAlignment="Center">
                                <StackPanel x:Name="WelcomePanel" Margin="0,42,0,28">
                                    <Border Width="52" Height="52" HorizontalAlignment="Center"
                                            Background="#FFF0F0F0" CornerRadius="14">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="#FF111111" FontWeight="Bold" Text="VM" />
                                    </Border>
                                    <TextBlock HorizontalAlignment="Center" Margin="0,18,0,0"
                                               FontSize="25" FontWeight="SemiBold" Text="为 VisionMaster 构建什么？" />
                                    <TextBlock HorizontalAlignment="Center" MaxWidth="600" Margin="0,9,0,0"
                                               Foreground="{StaticResource TextSecondary}" TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Text="描述脚本、输入输出或要修改的业务方案。Agent 会生成 Requirement，并用确定性编译器完成离线验证。" />
                                    <UniformGrid Columns="3" Margin="0,26,0,0">
                                        <Button Margin="4" Padding="13,11" HorizontalContentAlignment="Left"
                                                Tag="创建一个 C# 脚本方案，输入 A 和 B，输出 Sum，并设置可见默认值。"
                                                Click="Suggestion_Click">
                                            <StackPanel>
                                                <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="创建脚本方案" />
                                                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource TextMuted}"
                                                           TextWrapping="Wrap" Text="生成 C#、Python 或全局脚本" />
                                            </StackPanel>
                                        </Button>
                                        <Button Margin="4" Padding="13,11" HorizontalContentAlignment="Left"
                                                Tag="向已有 VisionMaster SOL 中加入一个脚本，并在修改前检查目标模块和参数。"
                                                Click="Suggestion_Click">
                                            <StackPanel>
                                                <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="修改已有 SOL" />
                                                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource TextMuted}"
                                                           TextWrapping="Wrap" Text="检查模块后安全注入脚本" />
                                            </StackPanel>
                                        </Button>
                                        <Button Margin="4" Padding="13,11" HorizontalContentAlignment="Left"
                                                Tag="创建一个引用外部 DLL 的 C# 脚本，并校验程序集版本、架构和部署依赖。"
                                                Click="Suggestion_Click">
                                            <StackPanel>
                                                <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="引用外部 DLL" />
                                                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource TextMuted}"
                                                           TextWrapping="Wrap" Text="验证版本、架构与部署依赖" />
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>

                                <StackPanel x:Name="MessagesPanel" />

                                <StackPanel>
                                    <TextBlock x:Name="FriendlyStatus" Visibility="Collapsed" Margin="40,3,40,12"
                                               TextWrapping="Wrap" FontSize="12"
                                               Foreground="{StaticResource TextSecondary}" />
                                    <Border x:Name="SuccessPanel" Visibility="Collapsed" Padding="14"
                                            Margin="40,0,40,12" Background="#FF112219"
                                            BorderBrush="#FF285A3B" BorderThickness="1" CornerRadius="9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Margin="0,0,9,0" Foreground="{StaticResource Success}"
                                                           FontWeight="Bold" Text="✓" />
                                                <TextBlock x:Name="SuccessText" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <WrapPanel Grid.Column="1" Margin="12,0,0,0">
                                                <Button x:Name="ConfirmVmButton" Margin="0,0,6,0"
                                                        Content="确认 VM 验证" Click="ConfirmVm_Click" />
                                                <Button x:Name="OpenDependenciesButton" Visibility="Collapsed" Margin="0,0,6,0"
                                                        Content="DLL 部署包" Click="OpenDependencies_Click" />
                                                <Button Margin="0,0,6,0" Content="复制路径" Click="CopyResultPath_Click" />
                                                <Button Content="打开" Click="OpenResultFolder_Click" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>

                                    <Expander x:Name="AdvancedDeterministicTools" Margin="40,4,40,18"
                                              Visibility="Collapsed"
                                              Header="开发者工具与诊断">
                                        <Border Margin="0,9,0,0" Padding="14" Background="{StaticResource Surface}"
                                                BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="82" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="Requirement" />
                                                    <TextBox x:Name="SpecPathText" Grid.Column="1" Height="34"
                                                             Margin="0,0,8,0" Padding="8,5" />
                                                    <Button Grid.Column="2" Content="选择…" Click="BrowseSpec_Click" />
                                                </Grid>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="82" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="输出目录" />
                                                    <TextBox x:Name="OutputPathText" Grid.Column="1" Height="34"
                                                             Margin="0,0,8,0" Padding="8,5" />
                                                    <Button Grid.Column="2" Content="选择…" Click="BrowseOutput_Click" />
                                                </Grid>
                                                <WrapPanel x:Name="ActionPanel">
                                                    <Button Margin="0,0,7,7" Content="校验 Requirement" Click="Plan_Click" />
                                                    <Button Margin="0,0,7,7" Content="创建 SOL" Click="Build_Click" />
                                                    <Button Margin="0,0,7,7" Content="Patch SOL" Click="Patch_Click" />
                                                    <Button Margin="0,0,7,7" Content="验证 SOL" Click="Validate_Click" />
                                                    <Button Margin="0,0,7,7" Content="检测环境" Click="Detect_Click" />
                                                </WrapPanel>
                                                <TextBox x:Name="ResultText" Height="150" Margin="0,2,0,0"
                                                         IsReadOnly="True" AcceptsReturn="True"
                                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                         FontFamily="Cascadia Mono,Consolas" FontSize="11.5"
                                                         TextWrapping="NoWrap" Padding="10" />
                                            </StackPanel>
                                        </Border>
                                    </Expander>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="1" Padding="22,10,22,22" Background="{StaticResource AppBackground}">
                            <StackPanel Width="900" MaxWidth="900" HorizontalAlignment="Center">
                                <Border x:Name="BaseSolutionPanel" Visibility="Collapsed" Margin="10,0,10,8"
                                        Padding="10,7" Background="#FF161616" BorderBrush="{StaticResource Border}"
                                        BorderThickness="1" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="11"
                                                   Foreground="{StaticResource TextMuted}" Text="基底 SOL" />
                                        <TextBox x:Name="BaseSolutionText" Grid.Column="1" BorderThickness="0"
                                                 Background="Transparent" IsReadOnly="True" FontSize="11.5" />
                                        <Button Grid.Column="2" Margin="8,0,0,0" Padding="9,4"
                                                Content="选择" Click="BrowseBase_Click" />
                                    </Grid>
                                </Border>

                                <Border Background="#FF1A1A1A" BorderBrush="#FF424242" BorderThickness="1"
                                        CornerRadius="15" Padding="14,12,12,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="92" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock x:Name="PromptPlaceholder" Margin="3,2,0,0"
                                                       IsHitTestVisible="False" Foreground="#FF777777"
                                                       FontSize="14.5" Text="描述要创建或修改的 VisionMaster 脚本…" />
                                            <TextBox x:Name="PromptText" BorderThickness="0" Background="Transparent"
                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto" FontSize="14.5"
                                                     TextChanged="PromptText_TextChanged"
                                                     PreviewKeyDown="PromptText_PreviewKeyDown" />
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,9,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <RadioButton x:Name="CreateModeRadio" Content="创建"
                                                             IsChecked="True" Margin="2,0,16,0" Checked="Mode_Changed" />
                                                <RadioButton x:Name="PatchModeRadio" Content="Patch 已有方案"
                                                             Margin="0,0,16,0" Checked="Mode_Changed" />
                                                <Border Padding="8,3" Background="#FF222222" CornerRadius="8">
                                                    <TextBlock x:Name="AiStatusText" MaxWidth="340" FontSize="10.5"
                                                               Foreground="{StaticResource TextMuted}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="正在初始化 Pi Runtime…" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button x:Name="StopButton" Visibility="Collapsed"
                                                        Style="{StaticResource IconButton}" Margin="0,0,7,0"
                                                        Content="■" ToolTip="停止任务" Click="Stop_Click" />
                                                <Button x:Name="GenerateButton" Style="{StaticResource SendButton}"
                                                        Content="↑" ToolTip="发送（Enter）" Click="Generate_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center"
                                           FontSize="10.5" Foreground="{StaticResource TextMuted}"
                                           Text="Enter 发送 · Shift+Enter 换行 · SOL 仅由确定性编译器修改" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="ArtifactsTab">
                    <Grid Width="980" MaxWidth="980" Margin="34,26" HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="结果产物" />
                                <TextBlock x:Name="ArtifactSummaryText" Margin="0,6,0,0"
                                           Foreground="{StaticResource TextSecondary}" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Content="↻  重新索引" Click="RefreshArtifacts_Click" />
                        </Grid>
                        <Border Grid.Row="1" Margin="0,0,0,14" Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="9">
                            <Grid>
                                <TextBlock Margin="13,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMuted}" Text="⌕" />
                                <TextBox x:Name="ArtifactSearchText" Height="42" Padding="37,10,12,8"
                                         Background="Transparent" BorderThickness="0"
                                         TextChanged="ArtifactSearch_Changed" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <StackPanel x:Name="ArtifactEmptyPanel" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock HorizontalAlignment="Center" FontSize="26"
                                               Foreground="{StaticResource TextMuted}" Text="▣" />
                                    <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center"
                                               FontWeight="SemiBold" Text="还没有结果产物" />
                                    <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextMuted}"
                                               Text="完成任务后，SOL、报告和生成脚本会显示在这里。" />
                                </StackPanel>
                                <ListBox x:Name="ArtifactList" Padding="4" MouseDoubleClick="ArtifactList_DoubleClick">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ArtifactChrome" Padding="14,12" CornerRadius="7">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ArtifactChrome" Property="Background" Value="{StaticResource SurfaceHover}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ArtifactChrome" Property="Background" Value="#FF292929" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Padding="8,4" Margin="0,0,14,0" VerticalAlignment="Center"
                                                    Background="#FF242424" CornerRadius="6">
                                                <TextBlock HorizontalAlignment="Center" FontSize="11"
                                                           Foreground="{StaticResource TextSecondary}" Text="{Binding Kind}" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding FileName}" />
                                                <TextBlock Margin="0,4,0,0" FontSize="11"
                                                           Foreground="{StaticResource TextMuted}"
                                                           Text="{Binding TaskDirectory}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                                                       FontSize="11" Foreground="{StaticResource TextMuted}"
                                                       Text="{Binding DisplayTime}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Margin="0,0,8,0" Content="打开文件" Click="OpenArtifact_Click" />
                            <Button Content="在文件夹中显示" Click="OpenArtifactFolder_Click" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem x:Name="SettingsTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Width="780" MaxWidth="780" Margin="36,30,36,50" HorizontalAlignment="Center">
                            <TextBlock FontSize="24" FontWeight="SemiBold" Text="设置" />
                            <TextBlock Margin="0,6,0,22" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                                       Text="配置模型连接和本地产物目录。API Key 使用 Windows 当前用户密钥加密保存。" />

                            <Border Padding="20" Margin="0,0,0,14" Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="11">
                                <StackPanel>
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="模型" />
                                    <TextBlock Margin="0,4,0,18" FontSize="11.5" Foreground="{StaticResource TextMuted}"
                                               Text="用于把自然语言转换为 Requirement，模型不能直接编辑 SOL。" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="API 协议（决定请求路径）" />
                                    <ComboBox x:Name="SettingsProviderChoice" Height="38" Margin="0,0,0,15" Padding="7">
                                        <ComboBoxItem Tag="openai-responses" Content="OpenAI Responses（推荐）" />
                                        <ComboBoxItem Tag="openai-compatible" Content="OpenAI-compatible Chat Completions" />
                                    </ComboBox>
                                    <TextBlock Margin="0,-9,0,15" Foreground="#8B8B8B" FontSize="11"
                                               TextWrapping="Wrap"
                                               Text="Responses 调用 /responses；DeepSeek 等兼容服务请选择 Chat Completions，调用 /chat/completions。当前只保存一套正在使用的地址、模型和 Key。DeepSeek 的低/中/高均映射为 high，很高映射为 max。" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="API 基础地址" />
                                    <TextBox x:Name="SettingsEndpointText" Style="{StaticResource SettingsInput}"
                                             Margin="0,0,0,15" ToolTip="例如 https://api.openai.com/v1，不要填写 /responses" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="模型 ID" />
                                            <TextBox x:Name="SettingsModelText" Style="{StaticResource SettingsInput}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="推理强度" />
                                            <ComboBox x:Name="SettingsThinkingChoice" Height="38" Padding="7">
                                                <ComboBoxItem Tag="low" Content="低" />
                                                <ComboBoxItem Tag="medium" Content="中" />
                                                <ComboBoxItem Tag="high" Content="高（推荐）" />
                                                <ComboBoxItem Tag="xhigh" Content="很高" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,15,0,7" Text="API Key" />
                                    <PasswordBox x:Name="SettingsApiKeyBox" Height="38" Padding="10,7" />
                                </StackPanel>
                            </Border>

                            <Border Padding="20" Margin="0,0,0,14" Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="11">
                                <StackPanel>
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="本地数据" />
                                    <TextBlock Margin="0,4,0,18" FontSize="11.5" Foreground="{StaticResource TextMuted}"
                                               Text="管理生成结果、会话和桌面配置文件。" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="默认输出目录" />
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="88" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SettingsOutputPathText" Style="{StaticResource SettingsInput}"
                                                 Margin="0,0,8,0" />
                                        <Button Grid.Column="1" Content="选择…" Click="BrowseSettingsOutput_Click" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="配置文件" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="88" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SettingsFilePathText" Style="{StaticResource SettingsInput}"
                                                 Margin="0,0,8,0" IsReadOnly="True" />
                                        <Button Grid.Column="1" Content="打开" Click="OpenSettingsFile_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryButton}" Padding="18,9"
                                            Content="保存并重启 Agent" Click="SaveSettings_Click" />
                                    <Button Margin="9,0,0,0" Padding="16,9"
                                            Content="打开数据目录" Click="OpenStateDirectory_Click" />
                                    <Button Margin="9,0,0,0" Padding="16,9"
                                            Content="开发者工具" Click="ShowDeveloperTools_Click" />
                                </StackPanel>
                                <TextBlock x:Name="SettingsStatusText" Margin="250,0,0,0"
                                           VerticalAlignment="Center" TextAlignment="Right"
                                           Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
