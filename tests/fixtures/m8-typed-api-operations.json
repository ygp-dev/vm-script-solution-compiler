{
  "schemaVersion": "1.0",
  "task": { "name": "m8-typed-api-operations", "mode": "create", "vmVersion": "4.4.0" },
  "scripts": [
    {
      "id": "typed-api", "carrier": "csharp-module", "name": "类型API生成", "procedure": "流程1",
      "execution": { "mode": "once" },
      "inputs": [
        { "name": "Enabled", "type": "bool", "default": true },
        { "name": "IntValue", "type": "int" }, { "name": "Ints", "type": "int[]" },
        { "name": "FloatValue", "type": "float" }, { "name": "Floats", "type": "float[]" },
        { "name": "Text", "type": "string" }, { "name": "Texts", "type": "string[]" },
        { "name": "Bytes", "type": "byte" }, { "name": "Image", "type": "image" },
        { "name": "Box", "type": "roibox" }, { "name": "Boxes", "type": "roibox[]" },
        { "name": "Annuli", "type": "roiannulus" }, { "name": "Polygons", "type": "roipolygon" },
        { "name": "Points", "type": "point" }, { "name": "Lines", "type": "line" },
        { "name": "Fixtures", "type": "fixture" },
        { "name": "Rects", "type": "rect" }, { "name": "Ellipses", "type": "ellipse" },
        { "name": "Pointset", "type": "pointset" }
      ],
      "outputs": [
        { "name": "EnabledEcho", "type": "bool" },
        { "name": "FirstInt", "type": "int" }, { "name": "IntsEcho", "type": "int[]" },
        { "name": "FloatEcho", "type": "float" }, { "name": "FloatsEcho", "type": "float[]" },
        { "name": "TextEcho", "type": "string" }, { "name": "TextsEcho", "type": "string[]" },
        { "name": "BytesEcho", "type": "byte" }, { "name": "ImageEcho", "type": "image" },
        { "name": "BoxEcho", "type": "roibox" }, { "name": "BoxesEcho", "type": "roibox[]" },
        { "name": "AnnuliEcho", "type": "roiannulus" }, { "name": "PolygonsEcho", "type": "roipolygon" },
        { "name": "PointsEcho", "type": "point" }, { "name": "LinesEcho", "type": "line" },
        { "name": "FixturesEcho", "type": "fixture" },
        { "name": "RectsEcho", "type": "rect" }, { "name": "EllipsesEcho", "type": "ellipse" },
        { "name": "PointsetEcho", "type": "pointset" }
      ],
      "operations": [
        { "kind": "setOutput", "parameter": "EnabledEcho", "value": { "kind": "input", "name": "Enabled" } },
        { "kind": "setOutput", "parameter": "FirstInt", "condition": { "kind": "binary", "operator": "greaterThan", "left": { "kind": "input", "name": "IntValue" }, "right": 0 }, "value": { "kind": "index", "target": { "kind": "input", "name": "Ints" }, "index": 0 } },
        { "kind": "setOutput", "parameter": "IntsEcho", "value": { "kind": "input", "name": "Ints" } },
        { "kind": "setOutput", "parameter": "FloatEcho", "value": { "kind": "input", "name": "FloatValue" } },
        { "kind": "setOutput", "parameter": "FloatsEcho", "value": { "kind": "input", "name": "Floats" } },
        { "kind": "setOutput", "parameter": "TextEcho", "value": { "kind": "input", "name": "Text" } },
        { "kind": "setOutput", "parameter": "TextsEcho", "value": { "kind": "input", "name": "Texts" } },
        { "kind": "setOutput", "parameter": "BytesEcho", "value": { "kind": "input", "name": "Bytes" } },
        { "kind": "setOutput", "parameter": "ImageEcho", "value": { "kind": "input", "name": "Image" } },
        { "kind": "setOutput", "parameter": "BoxEcho", "value": { "kind": "input", "name": "Box" } },
        { "kind": "setOutput", "parameter": "BoxesEcho", "value": { "kind": "input", "name": "Boxes" } },
        { "kind": "setOutput", "parameter": "AnnuliEcho", "value": { "kind": "input", "name": "Annuli" } },
        { "kind": "setOutput", "parameter": "PolygonsEcho", "value": { "kind": "input", "name": "Polygons" } },
        { "kind": "setOutput", "parameter": "PointsEcho", "value": { "kind": "input", "name": "Points" } },
        { "kind": "setOutput", "parameter": "LinesEcho", "value": { "kind": "input", "name": "Lines" } },
        { "kind": "setOutput", "parameter": "FixturesEcho", "value": { "kind": "input", "name": "Fixtures" } },
        { "kind": "setOutput", "parameter": "RectsEcho", "value": { "kind": "input", "name": "Rects" } },
        { "kind": "setOutput", "parameter": "EllipsesEcho", "value": { "kind": "input", "name": "Ellipses" } },
        { "kind": "setOutput", "parameter": "PointsetEcho", "value": { "kind": "input", "name": "Pointset" } },
        { "kind": "getModule", "module": "类型API生成", "result": "targetModule" },
        { "kind": "getModuleValue", "module": "类型API生成", "parameter": "ModuStatus", "result": "moduleStatus", "valueType": "int" },
        { "kind": "getModuleArray", "module": "类型API生成", "parameter": "Floats", "result": "moduleValues", "valueType": "float[]" },
        { "kind": "getModuleParam", "module": "类型API生成", "parameter": "IntValue", "result": "moduleParam" },
        { "kind": "setModuleValue", "module": "类型API生成", "parameter": "IntValue", "value": "0" },
        { "kind": "getGlobalVariable", "parameter": "VInt", "result": "vInt", "valueType": "int" },
        { "kind": "getGlobalVariable", "parameter": "VInts", "result": "vInts", "valueType": "int[]" },
        { "kind": "getGlobalVariable", "parameter": "VFloat", "result": "vFloat", "valueType": "float" },
        { "kind": "getGlobalVariable", "parameter": "VFloats", "result": "vFloats", "valueType": "float[]" },
        { "kind": "getGlobalVariable", "parameter": "VText", "result": "vText", "valueType": "string" },
        { "kind": "getGlobalVariable", "parameter": "VTexts", "result": "vTexts", "valueType": "string[]" },
        { "kind": "getGlobalVariable", "parameter": "VBytes", "result": "vBytes", "valueType": "byte" },
        { "kind": "getGlobalVariable", "parameter": "VImage", "result": "vImage", "valueType": "image" },
        { "kind": "getGlobalVariable", "parameter": "VBox", "result": "vBox", "valueType": "roibox" },
        { "kind": "getGlobalVariable", "parameter": "VBoxes", "result": "vBoxes", "valueType": "roibox[]" },
        { "kind": "getGlobalVariable", "parameter": "VAnnuli", "result": "vAnnuli", "valueType": "roiannulus" },
        { "kind": "getGlobalVariable", "parameter": "VPolygons", "result": "vPolygons", "valueType": "roipolygon" },
        { "kind": "getGlobalVariable", "parameter": "VPoints", "result": "vPoints", "valueType": "point" },
        { "kind": "getGlobalVariable", "parameter": "VLines", "result": "vLines", "valueType": "line" },
        { "kind": "getGlobalVariable", "parameter": "VFixtures", "result": "vFixtures", "valueType": "fixture" },
        { "kind": "getGlobalVariable", "parameter": "VCircles", "result": "vCircles", "valueType": "circle" },
        { "kind": "getGlobalVariable", "parameter": "VRects", "result": "vRects", "valueType": "rect" },
        { "kind": "getGlobalVariable", "parameter": "VEllipses", "result": "vEllipses", "valueType": "ellipse" },
        { "kind": "getGlobalVariable", "parameter": "VPointset", "result": "vPointset", "valueType": "pointset" },
        { "kind": "setLocalVariable", "parameter": "VInt", "valueType": "int", "value": { "kind": "input", "name": "IntValue" } },
        { "kind": "setLocalVariable", "parameter": "VInts", "valueType": "int[]", "value": { "kind": "input", "name": "Ints" } },
        { "kind": "setLocalVariable", "parameter": "VFloat", "valueType": "float", "value": { "kind": "input", "name": "FloatValue" } },
        { "kind": "setLocalVariable", "parameter": "VFloats", "valueType": "float[]", "value": { "kind": "input", "name": "Floats" } },
        { "kind": "setLocalVariable", "parameter": "VText", "valueType": "string", "value": { "kind": "input", "name": "Text" } },
        { "kind": "setLocalVariable", "parameter": "VTexts", "valueType": "string[]", "value": { "kind": "input", "name": "Texts" } },
        { "kind": "setLocalVariable", "parameter": "VBytes", "valueType": "byte", "value": { "kind": "input", "name": "Bytes" } },
        { "kind": "setLocalVariable", "parameter": "VImage", "valueType": "image", "value": { "kind": "input", "name": "Image" } },
        { "kind": "setLocalVariable", "parameter": "VBox", "valueType": "roibox", "value": { "kind": "input", "name": "Box" } },
        { "kind": "setLocalVariable", "parameter": "VBoxes", "valueType": "roibox[]", "value": { "kind": "input", "name": "Boxes" } },
        { "kind": "setLocalVariable", "parameter": "VAnnuli", "valueType": "roiannulus", "value": { "kind": "input", "name": "Annuli" } },
        { "kind": "setLocalVariable", "parameter": "VPolygons", "valueType": "roipolygon", "value": { "kind": "input", "name": "Polygons" } },
        { "kind": "setLocalVariable", "parameter": "VPoints", "valueType": "point", "value": { "kind": "input", "name": "Points" } },
        { "kind": "setLocalVariable", "parameter": "VLines", "valueType": "line", "value": { "kind": "input", "name": "Lines" } },
        { "kind": "setLocalVariable", "parameter": "VFixtures", "valueType": "fixture", "value": { "kind": "input", "name": "Fixtures" } },
        { "kind": "setLocalVariable", "parameter": "VCircles", "valueType": "circle", "value": { "kind": "result", "name": "vCircles" } },
        { "kind": "setLocalVariable", "parameter": "VRects", "valueType": "rect", "value": { "kind": "input", "name": "Rects" } },
        { "kind": "setLocalVariable", "parameter": "VEllipses", "valueType": "ellipse", "value": { "kind": "input", "name": "Ellipses" } },
        { "kind": "setLocalVariable", "parameter": "VPointset", "valueType": "pointset", "value": { "kind": "input", "name": "Pointset" } },
        { "kind": "bytesToPointset", "value": { "kind": "input", "name": "Pointset" }, "result": "contourPoints" },
        { "kind": "log", "value": "typed api complete" },
        { "kind": "sleep", "milliseconds": 0 }
      ],
      "dependencies": []
    },
    {
      "id": "typed-python", "carrier": "python-module", "name": "Python数组默认值", "procedure": "流程1",
      "execution": { "mode": "once" },
      "inputs": [{ "name": "Values", "type": "int[]", "default": [1, 2, 3] }],
      "outputs": [{ "name": "Echo", "type": "int[]" }],
      "operations": [{ "kind": "setOutput", "parameter": "Echo", "value": { "kind": "input", "name": "Values" } }],
      "dependencies": []
    },
    {
      "id": "global-control", "carrier": "global-csharp", "name": "全局控制API",
      "execution": { "mode": "once" }, "inputs": [], "outputs": [],
      "operations": [
        { "kind": "setContinuousInterval", "milliseconds": 50 },
        { "kind": "startGlobalCommunication" },
        { "kind": "sendCommunication", "deviceId": 1, "addressId": -1, "dataType": "string", "value": "PING" },
        { "kind": "setProcedureInput", "procedure": "流程1", "parameter": "intX", "valueType": "int", "value": 10 },
        { "kind": "saveSolution", "value": "C:\\Temp\\generated-save.sol" },
        { "kind": "loadSolution", "value": "C:\\Temp\\generated-load.sol" },
        { "kind": "runProcedure", "procedure": "流程1" },
        { "kind": "continuousProcedure", "procedure": "流程1" },
        { "kind": "stopProcedure", "procedure": "流程1", "milliseconds": 500 },
        { "kind": "log", "value": "global control complete" },
        { "kind": "sleep", "milliseconds": 0 }
      ],
      "dependencies": []
    }
  ],
  "connections": []
}
