{
  "schemaVersion": "1.0",
  "task": { "name": "mcp-csharp-scalars", "mode": "create", "vmVersion": "4.4.0" },
  "scripts": [{
    "id": "csharp-scalars", "carrier": "csharp-module", "name": "CSharp标量验证", "procedure": "流程1",
