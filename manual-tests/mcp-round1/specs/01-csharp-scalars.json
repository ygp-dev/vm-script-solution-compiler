    "inputs": [
      { "name": "A", "type": "int", "default": 7, "required": true },
      { "name": "B", "type": "int", "default": 5, "required": true },
      { "name": "Enabled", "type": "bool", "default": true }
    ],
    "outputs": [
      { "name": "Sum", "type": "int", "default": 0 },
      { "name": "Passed", "type": "bool", "default": false },
      { "name": "Message", "type": "string", "default": "" }
    ],
    "operations": [
      { "kind": "setOutput", "parameter": "Sum", "value": { "kind": "binary", "operator": "add", "left": { "kind": "input", "name": "A" }, "right": { "kind": "input", "name": "B" } } },
      { "kind": "setOutput", "parameter": "Passed", "value": { "kind": "input", "name": "Enabled" } },
      { "kind": "setOutput", "parameter": "Message", "value": "MCP CSharp OK" }
    ],
    "dependencies": []
  }],
  "connections": []
